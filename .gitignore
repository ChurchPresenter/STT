models/
__pycache__/
.pytest_cache/
.ruff_cache/
logs/
.claude/
server.log
/_AUTOMATIC_BACKUP
.crash_token
# Live (user-mutated) config files and their tmp/backup/corrupt sidecars live in
# config/ beside the tracked *.default.json templates; legacy root-level names
# stay ignored for pre-migration stragglers.
config/*
!config/*.default.json
config.json
config.json.backup
config.json.tmp
config.json.before-restore
config.json.corrupt.*
download_progress.json
*.wav
*.log
.wrangler/
config.json.watchdog.tmp
watchdog.lock
icon.ico
icon.icns
icon.png
icon.iconset/
.DS_Store
CLAUDE-FABLE-*.md

# PANNs audio-tagger checkpoint (downloaded at runtime), but ship the small
# AudioSet label CSV so music detection works self-contained / offline.
panns_data/*
!panns_data/class_labels_indices.csv

# Python virtual environment
.venv/

# Python bytecode (stray .pyc files outside __pycache__)
*.pyc

# PyInstaller build output
build/
dist/

# Claude Code / impeccable skill working files
.impeccable/
.github/skills/
PRODUCT.md
MARKETING.md

# Coverage tooling artifact (pytest --cov)
.coverage

# Real service captions used as test fixtures. Verbatim congregation speech and its
# translations: kept on the machine that recorded it, never in a public repository.
# tests/ skips the cases that need it when the file is absent, so CI stays green.
tests/fixtures/real_captions.json

# Replay material, same rule and for the same reason. stt/translation_replay.py is
# the public part — the harness is just code, and belongs in the repository. What it
# reads and writes is a service: session databases and their copies, and the run
# files holding every caption a service produced alongside a model's translation of
# it. Those stay on the machine that recorded them, and they would bloat the
# repository besides — a single service is a few megabytes of JSON.
# Work in the scratchpad by preference; these patterns are the backstop for when
# something lands here anyway.
*.db
*.db-wal
*.db-shm
tests/fixtures/sessions/
replay-runs/
*.replay.json
